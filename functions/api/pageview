// GET  /api/votes?collection=main  → { votes: { "file.mp3": 5, ... } }
// POST /api/votes?collection=main&file=song.mp3  → { votes: 6 }
// Voting is only enabled for the main collection.

function json(body, status = 200) {
  return new Response(JSON.stringify(body), {
    status,
    headers: {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store",
    },
  });
}

function isValidFile(file) {
  if (!file) return false;
  if (!/\.mp3$/i.test(file)) return false;
  if (file.includes("/") || file.includes("\\") || file.includes("..")) return false;
  return true;
}

export async function onRequest({ request, env }) {
  const url = new URL(request.url);
  const collection = (url.searchParams.get("collection") || "main").toLowerCase();

  if (collection !== "main") {
    return json({ error: "Voting is only available for the main playlist" }, 403);
  }

  if (!env.STATS_KV) {
    return json({ error: "Storage not configured" }, 503);
  }

  if (request.method === "POST") {
    const file = url.searchParams.get("file") || "";
    if (!isValidFile(file)) {
      return json({ error: "Invalid file parameter" }, 400);
    }

    const key = `votes:main:${file}`;
    const current = parseInt((await env.STATS_KV.get(key)) || "0", 10);
    const updated = current + 1;
    await env.STATS_KV.put(key, String(updated));
    return json({ votes: updated });
  }

  // GET — return all vote counts
  const listResult = await env.STATS_KV.list({ prefix: "votes:main:" });
  const votes = {};
  await Promise.all(
    listResult.keys.map(async (keyMeta) => {
      const file = keyMeta.name.replace("votes:main:", "");
      votes[file] = parseInt((await env.STATS_KV.get(keyMeta.name)) || "0", 10);
    })
  );
  return json({ votes });
}
